      "items": {"$ref": "#/$defs/insight"}
    },
    "mistakes": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/insight"}
    },
    "decisions": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/insight"}
    },
    "context": {
